# ==============================================================================
# PatchGuard AI — Environment Configuration (.env.example)
# Copy this file to .env.local (for local development) and populate with real values.
# NEVER commit real secrets, service_role keys, or Gemini API keys to version control.
# ==============================================================================

# 1. Client-Safe Supabase Configuration (Exposed to browser via Vite VITE_ prefix)
# Safe to use in browser ONLY when Row Level Security (RLS) is enabled on all tables.
# Never place a service_role key or Gemini API key in any VITE_ variable.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Optional: Override Edge Function URL (defaults to ${VITE_SUPABASE_URL}/functions/v1/analyze-review)
VITE_SUPABASE_EDGE_FUNCTION_URL=""

# 2. Server-Side & Supabase Edge Function Configuration (NEVER expose with VITE_ prefix)
# Standard user-scoped API routes and Edge Functions use SUPABASE_ANON_KEY together with
# the caller's Authorization: Bearer <access_token> JWT so PostgreSQL RLS policies
# (auth.uid() = owner_id) enforce least-privilege tenant isolation.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# SUPABASE_SERVICE_ROLE_KEY: Optional server-only administrative key (bypasses RLS).
# Not used by browser clients or standard user request handlers.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-server-only"

# GEMINI_API_KEY: Server-only key required for Gemini semantic code reasoning.
# Configure in Supabase Edge Function secrets (`npx supabase secrets set GEMINI_API_KEY=...`)
# or in the Express server environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 3. Runtime Security & CORS Configuration
# APP_URL / ALLOWED_ORIGINS: Comma-separated list of allowed origins for CORS headers.
APP_URL="MY_APP_URL"
ALLOWED_ORIGINS="http://localhost:3000"

# ALLOW_LOCAL_DEV_AUTH: Enables the isolated, in-memory scrypt development auth sandbox
# ONLY when NODE_ENV !== "production" AND live SUPABASE_URL / SUPABASE_ANON_KEY are not set.
# Automatically refused when NODE_ENV="production" or when live Supabase Auth is configured.
ALLOW_LOCAL_DEV_AUTH="true"
